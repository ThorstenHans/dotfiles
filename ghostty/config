font-family = "JetBrainsMono Nerd Font"
font-size = 18
font-style = Regular
font-thicken = false

background-opacity = 0.95
theme = "TokyoNight Storm"
window-height = 40
window-width = 160
maximize = true

initial-command = "zsh -c 'tmux new-session -A -s main; exec zsh'"

copy-on-select = true

keybind = opt+left=unbind
keybind = opt+right=unbind
keybind = opt+up=unbind
keybind = opt+down=unbind
